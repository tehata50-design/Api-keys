{
  "name": "freekey-hub-wrapper",
  "version": "1.0.0",
  "private": true,
  "description": "Installable wrappers for the deployed FreeKey Hub website",
  "main": "electron/main.cjs",
  "scripts": {
    "android:init": "cap add android",
    "android:sync": "cap sync android",
    "windows:dev": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "ai.freekeyhub.desktop",
    "productName": "FreeKey Hub",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
